LOG_LEVEL=info

HTTP_PORT=8080
HTTP_REQUEST_TIMEOUT=10s
HTTP_SHUTDOWN_TIMEOUT=15s

DATABASE_URL=postgres://transactions:transactions@localhost:5432/transactions?sslmode=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
RUN_MIGRATIONS=false

PROVIDER_BASE_URL=http://localhost:8081
PROVIDER_REQUEST_TIMEOUT=3s
PROVIDER_DIAL_TIMEOUT=1s
PROVIDER_MAX_RETRIES=2
PROVIDER_RETRY_BASE_DELAY=100ms
PROVIDER_RETRY_MAX_DELAY=1s
PROVIDER_MAX_IDLE_CONNS=100
PROVIDER_MAX_IDLE_CONNS_PER_HOST=100
PROVIDER_IDLE_CONN_TIMEOUT=90s
PROVIDER_BREAKER_FAILURE_THRESHOLD=5
PROVIDER_BREAKER_OPEN_TIMEOUT=30s
PROVIDER_BREAKER_HALF_OPEN_MAX_REQUESTS=1
